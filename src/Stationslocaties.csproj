<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApiSeries Condition="'$(ApiSeries)' == ''">R25</ApiSeries>
    <TargetFramework Condition="'$(ApiSeries)' == 'R25'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(ApiSeries)' == 'R26'">net10.0-windows</TargetFramework>
    <ApiVersion Condition="'$(ApiSeries)' == 'R25'">25.0.1</ApiVersion>
    <ApiVersion Condition="'$(ApiSeries)' == 'R26'">26.0.0</ApiVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.4.29</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/Techbase.png" LogicalName="Techbase.png" />
    <EmbeddedResource Include="Resources/Timmermans.png" LogicalName="Timmermans.png" />
    <EmbeddedResource Include="Resources/StationGeometry.json.gz" LogicalName="StationGeometry.json.gz" />
    <EmbeddedResource Include="Resources/KlicRules.json" LogicalName="KlicRules.json" />
    <EmbeddedResource Include="Resources/KlicStyles.dxf.gz" LogicalName="KlicStyles.dxf.gz" />
    <PackageReference Include="AutoCAD.NET" Version="$(ApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
